# Enforce LF line endings for all text files
* text=auto eol=lf

# Explicitly declare text files to normalize
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.env*  text eol=lf
*.sh    text eol=lf
*.kt    text eol=lf
*.gradle text eol=lf
*.xml   text eol=lf
*.css   text eol=lf
*.html  text eol=lf
Dockerfile text eol=lf

# Keep Windows batch files with CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Binary files — no line ending conversion
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.zip   binary
*.gz    binary
*.apk   binary
*.aab   binary
*.jks   binary
*.keystore binary
*.db    binary
*.sqlite binary
