# Root .env.example — copy to .env and fill in real values
# cp .env.example .env

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Single password used for both the postgres container and the backend connection
POSTGRES_PASSWORD=your_secure_postgres_password

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_min_32_chars

# ── AWS (required for image/video storage) ────────────────────────────────────
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=talkar-assets

# ── External APIs ─────────────────────────────────────────────────────────────
AI_PROVIDER=groq
GROQCLOUD_API_KEY=your_groq_api_key

TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=your_elevenlabs_api_key
OPENAI_API_KEY=your_openai_api_key
GOOGLE_CLOUD_TTS_API_KEY=your_google_tts_api_key

# ── Wav2Lip worker (set to local for dev, sqs for prod) ───────────────────────
TALKING_PHOTO_RELEASE_PROFILE=internal
TALKING_PHOTO_QUEUE_MODE=local
TALKING_PHOTO_MIRROR_TO_S3=false
TALKING_PHOTO_ENABLE_WAV2LIP_FALLBACK=false
WAV2LIP_WORKER_URL=http://localhost:8088
WAV2LIP_WORKER_AUTH_TOKEN=your_worker_auth_token
WAV2LIP_WORKER_SIGNING_SECRET=your_worker_signing_secret

# ── Admin Dashboard ───────────────────────────────────────────────────────────
REACT_APP_API_URL=http://localhost:3000/api/v1

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3001
