# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/talkar_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=talkar_db
DB_USER=username
DB_PASSWORD=password

# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRES_IN=7d

# AWS Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=talkar-assets
# Wav2Lip Worker Configuration
TALKING_PHOTO_RELEASE_PROFILE=ga
TALKING_PHOTO_QUEUE_MODE=sqs
TALKING_PHOTO_MIRROR_TO_S3=true
TALKING_PHOTO_ENABLE_WAV2LIP_FALLBACK=false
WAV2LIP_WORKER_URL=http://127.0.0.1:8088
WAV2LIP_WORKER_PORT=8088
WAV2LIP_WORKER_AUTH_TOKEN=your-worker-auth-token
WAV2LIP_WORKER_SIGNING_SECRET=your-worker-signing-secret
WAV2LIP_WORKER_MAX_SKEW_MS=300000
WAV2LIP_WORKER_TIMEOUT_MS=900000
WAV2LIP_WORKER_WAIT_SECONDS=20
WAV2LIP_TTS_PROVIDER=macos-say
WAV2LIP_TTS_MAX_CHUNK_LENGTH=60
WAV2LIP_TTS_TIMEOUT_MS=15000
WAV2LIP_DOWNLOAD_TIMEOUT_MS=45000
WAV2LIP_FFMPEG_BIN=ffmpeg
WAV2LIP_FPS=5
WAV2LIP_RESIZE_FACTOR=6
WAV2LIP_FACE_DET_BATCH_SIZE=1
WAV2LIP_WAV2LIP_BATCH_SIZE=4
# Set these when running a real Wav2Lip checkout locally
WAV2LIP_PATH=/path/to/Wav2Lip
WAV2LIP_CHECKPOINT_PATH=/path/to/Wav2Lip/checkpoints/wav2lip_gan.pth
WAV2LIP_PYTHON_BIN=/path/to/Wav2Lip/.venv/bin/python
WAV2LIP_OUTPUT_DIR=./tmp/wav2lip-worker
WAV2LIP_PUBLIC_BASE_URL=http://127.0.0.1:8088

# AI Pipeline API Configuration
OPENAI_API_KEY=your-openai-api-key
ELEVENLABS_API_KEY=your-elevenlabs-api-key
GROQCLOUD_API_KEY=your-groqcloud-api-key
GOOGLE_CLOUD_TTS_API_KEY=your-google-cloud-tts-api-key

# AI Provider Selection (openai or groq)
AI_PROVIDER=openai

# TTS Provider Selection (elevenlabs or google)
TTS_PROVIDER=elevenlabs

# CORS Configuration
CORS_ORIGIN=http://localhost:3001

# File Upload Configuration
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp
