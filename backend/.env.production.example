# Production database
DATABASE_URL=postgresql://username:password@db-host:5432/talkar_db

# Server
PORT=3000
NODE_ENV=production
BASE_URL=https://api.talkar.com
CORS_ORIGIN=https://admin.talkar.com

# Auth
JWT_SECRET=replace-with-a-strong-secret
JWT_EXPIRES_IN=7d

# AWS
AWS_ACCESS_KEY_ID=replace-with-aws-access-key
AWS_SECRET_ACCESS_KEY=replace-with-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=talkar-production-assets

# Poster talk runtime
TALKING_PHOTO_RELEASE_PROFILE=ga
TALKING_PHOTO_QUEUE_MODE=sqs
TALKING_PHOTO_MIRROR_TO_S3=true
TALKING_PHOTO_ENABLE_WAV2LIP_FALLBACK=false
TALKING_PHOTO_SQS_URL=https://sqs.us-east-1.amazonaws.com/123456789012/talkar-talking-photo

# Wav2Lip worker
WAV2LIP_WORKER_URL=http://talkar-wav2lip-worker-service:8088
WAV2LIP_WORKER_AUTH_TOKEN=replace-with-worker-auth-token
WAV2LIP_WORKER_SIGNING_SECRET=replace-with-worker-signing-secret
WAV2LIP_WORKER_TIMEOUT_MS=900000
WAV2LIP_WORKER_MAX_SKEW_MS=300000

# Wav2Lip worker runtime
WAV2LIP_TTS_PROVIDER=gtts
WAV2LIP_TTS_MAX_CHUNK_LENGTH=60
WAV2LIP_TTS_TIMEOUT_MS=15000
WAV2LIP_DOWNLOAD_TIMEOUT_MS=45000
WAV2LIP_FFMPEG_BIN=ffmpeg
WAV2LIP_FPS=5
WAV2LIP_RESIZE_FACTOR=6
WAV2LIP_FACE_DET_BATCH_SIZE=1
WAV2LIP_WAV2LIP_BATCH_SIZE=4

# Storage + artifact delivery
TALKING_PHOTO_MIRROR_TO_S3=true
TALKING_PHOTO_KEEP_LATEST_N=3

# AI/TTS providers
TTS_PROVIDER=gtts
AI_PROVIDER=groq

# External service keys
GROQCLOUD_API_KEY=replace-with-groq-api-key
GOOGLE_CLOUD_TTS_API_KEY=replace-with-google-tts-key
ELEVENLABS_API_KEY=replace-with-elevenlabs-key
